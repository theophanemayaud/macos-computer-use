# Copy to config.local (gitignored). TCC binds to BUNDLE_ID + the
# codesign identity. Changing BUNDLE_ID means re-granting Accessibility
# and Screen Recording.
#
# Shell env vars with the same names override this file (CODESIGN_IDENTITY,
# BUNDLE_ID, …).

BUNDLE_ID='com.example.cursor-desktop'
APP_DISPLAY_NAME='Cursor Desktop'
APP_BUNDLE='Cursor Desktop.app'
EXEC='CursorDesktop'
SERVER_EXEC='CursorDesktopServer'
# Full keychain identity, e.g. 'Developer ID Application: NAME (TEAMID)'.
# If empty, build.sh uses the first Developer ID Application, then Apple Development.
CODESIGN_IDENTITY=''
# Defaults to BUNDLE_ID.mcp
LAUNCHD_LABEL=''
# Unix socket folder under ~/Library/Application Support/ (keep it short; AF_UNIX is ~104 bytes).
SUPPORT_DIR='cursor-desktop'
